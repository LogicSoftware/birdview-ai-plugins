# Copy to env/.env.prod. Provision writes the generated IDs below into that copy, so it stays out of git.
TEAMSFX_ENV=prod
APP_NAME_SUFFIX=

# Birdview MCP server (universal host for every account) and its system OAuth client.
BIRDVIEW_MCP_ORIGIN=https://mcp.go.easyprojects.net
BIRDVIEW_OAUTH_CLIENT_ID=m365Copilot
BIRDVIEW_OAUTH_SCOPE=user
# The client secret goes in env/.env.prod.user as SECRET_BIRDVIEW_OAUTH_CLIENT_SECRET=...

# Generated during provision.
TEAMS_APP_ID=
BIRDVIEW_OAUTH_AUTH_ID=
M365_TITLE_ID=
M365_APP_ID=
